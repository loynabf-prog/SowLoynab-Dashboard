# Kopiere diese Datei nach ".env.local" und trage die echten Werte ein.
# .env.local wird NICHT ins Git committet (siehe .gitignore).

# --- Supabase (Frontend) ---
# Zu finden im Supabase-Dashboard unter: Project Settings -> API
VITE_SUPABASE_URL=https://DEIN-PROJEKT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key

# Hinweis: Der anon key ist oeffentlich (durch Row-Level-Security geschuetzt)
# und darf im Frontend-Bundle landen. Der service_role-Key gehoert NIEMALS
# hierher — der lebt nur server-seitig in Supabase Edge Function Secrets.
